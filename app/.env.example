# ── Supabase (anon/public key — safe to use in client app) ──────────────────
# Copy from: Supabase Studio → Project Settings → API → Project URL / anon public key
# Create a .env file with real values (never commit .env — it's in .gitignore)

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Shared password used to sign in participants 01–31 (login screen only asks
# for the number). Does NOT apply to the "formador" account.
VITE_SHARED_LOGIN_PASSWORD=change-me

# Shared HMAC secret with Healme-egyt-forms' AUTOLOGIN_SECRET — must match
# exactly on both sides. Generate with: openssl rand -hex 32
VITE_FORMS_AUTOLOGIN_SECRET=change-me
