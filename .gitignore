# ══════════════════════════════════════════════════════════════
#  Neroes Polar Pipeline — Root .gitignore
#  Regra de ouro: em caso de dúvida, ignorar.
# ══════════════════════════════════════════════════════════════

# ── Secrets & credentials — NUNCA commitar ────────────────────
config/secrets.yaml
config/tokens.yaml
.env
app/.env
app/.env.local
app/.env.*.local

# Vercel CLI project link + pulled env vars (contains real secrets)
.vercel/

# Keystore Android — vive APENAS na máquina Windows local
app/android/keystore.properties
neroes-release-keys/
*.jks
*.keystore

# ── Participant data — RGPD: dados clínicos fora do repositório ─
data/raw/
data/processed/
data/reports/
# device_id = MAC address da banda Polar → identifica dispositivo → fora do repo
config/participants.yaml
# Exportações clínicas (ECG, RR, métricas) — sincronizadas via Google Drive
HE26_export/
*_export/

# ── Artefactos de build e dependências ────────────────────────
app/node_modules/
app/dist/
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Pastas nativas Android/iOS ─────────────────────────────────
# Geradas localmente via "npx cap add android/ios" + sync.
# Regras detalhadas (incl. exceções para ficheiros escritos à mão,
# que nenhuma tool regenera) vivem em app/.gitignore.
.capacitor/

# ── Python / Jupyter ──────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb~
.venv/
venv/
env/

# ── Editores & OS ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Scripts: seguros (lêem segredos via config/secrets.yaml) ──
# scripts/ é rastreado — scripts não contêm chaves hardcoded
